<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for the microphone under the hardened runtime (needed for notarization).
         The app is intentionally not sandboxed: it needs an event tap and Accessibility to paste. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
